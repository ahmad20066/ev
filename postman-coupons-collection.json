                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"code\": \"GLOBAL10\",\n  \"discount_type\": \"percentage\",\n  \"discount_value\": 10,\n  \"expiry_date\": \"2025-12-31\",\n  \"usage_limit\": 100,\n  \"is_active\": true\n}"
                },
                "url": {
                    "raw": "http://localhost:8080/admin/coupons",
                    "host": [
                        "http://localhost:8080"
                    ],
                    "path": [
                        "admin",
                        "coupons"
                    ]
                }
            }
        },
